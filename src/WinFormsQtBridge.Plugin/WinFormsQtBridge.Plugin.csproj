<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AssemblyName>WinFormsQtBridge.Plugin</AssemblyName>
        <RootNamespace>WinFormsQtBridge.Plugin</RootNamespace>
        <OutputType>Library</OutputType>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System" />
        <PackageReference Include="System.Core" />
        <PackageReference Include="System.Windows.Forms" />
        <PackageReference Include="NLog" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="MessagePack" Version="3.1.4" />
        <PackageReference Include="NetMQ" Version="4.0.2.2" />
    </ItemGroup>
    <ItemGroup>
        <Reference  Include="IP_Base" HintPath="..\..\lib\IP_Base.dll" />
        <Reference  Include="IP_Borehhole" HintPath="..\..\lib\IP_Borehhole.dll" />
        <Reference  Include="IP_Geometry" HintPath="..\..\lib\IP_Geometry.dll" />
        <Reference  Include="IP_IO" HintPath="..\..\lib\IP_IO.dll" />
        <Reference  Include="IP_Seismic" HintPath="..\..\lib\IP_Seismic.dll" />
    </ItemGroup>
    <Target Name="BuildPythonScript" BeforeTargets="Build">
        <PropertyGroup>
            <VenvDir>$(ProjectDir)python-script\venv</VenvDir>
            <PythonExe>$(ProjectDir)python-script\venv\Scripts\python.exe</PythonExe>
            <Requirements>$(ProjectDir)python-script\requirements.txt</Requirements>
            <PyInstallerExe>$(ProjectDir)python-script\venv\Scripts\pyinstaller.exe</PyInstallerExe>
            <PythonScript>$(ProjectDir)python-script\main.py</PythonScript>
            <ExeOutputDir>$(ProjectDir)python-script</ExeOutputDir>
        </PropertyGroup>
        <Exec Command="py -3.12 -m venv &quot;$(VenvDir)&quot;" />
        <Exec Command="&quot;$(PythonExe)&quot; -m pip install -r &quot;$(Requirements)&quot;" />
        <Exec Command="&quot;$(PyInstallerExe)&quot; --onefile --noconsole --distpath &quot;$(ExeOutputDir)&quot; --workpath &quot;$(ExeOutputDir)\build&quot; --specpath &quot;$(ExeOutputDir)&quot; &quot;$(PythonScript)&quot;" />
    </Target>
</Project>
